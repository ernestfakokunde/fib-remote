# MongoDB connection string used by Mongoose.
MONGO_URI=mongodb://127.0.0.1:27017/spectra-inventory

# Secret used to sign and verify authentication JWTs. Replace with a long,
# random value before running the application outside local development.
JWT_SECRET=replace-with-a-long-random-secret

# Express server port (defaults to 5000 when omitted).
PORT=5000

# Optional additional allowed frontend origin for CORS.
FRONTEND_URL=http://localhost:5173

# Google Gemini API key used only by the server-side snap-to-add endpoint.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Active Gemini Flash model. gemini-3.5-flash is deprecated/routed to 3.6; use 3.8 for new deployments.
GEMINI_MODEL=gemini-3.8-flash

# Configure secret credentials in the deployment environment.
PAYSTACK_SECRET_KEY=sk_test_replace-with-your-paystack-secret
PAYSTACK_CURRENCY=USD
